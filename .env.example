# Copy to .env locally or configure these secrets in your backend host.
# Never put an OpenAI key in GitHub Pages, browser JavaScript, or a repository variable.
OPENAI_API_KEY=
# Choose a Responses API model supporting strict structured outputs from your account.
OPENAI_MODEL=
HOST=127.0.0.1
PORT=4173
DATABASE_PATH=./data/qiban.sqlite
NODE_ENV=development
# Production: use the full HTTPS origin of the backend (which also serves the UI).
PUBLIC_ORIGIN=http://localhost:4173
# Required in production; share this invitation code only with people allowed to register.
REGISTRATION_CODE=
AI_USER_DAILY_LIMIT=60
AI_GLOBAL_DAILY_LIMIT=300
